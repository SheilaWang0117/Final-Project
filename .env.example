# Copy to .env (in this folder) or keep a .env one directory above this repository.
# Load order: explicit environment variables > ./.env > ../.env. Never commit real keys.

# demo = synthetic data + fixtures, no keys needed; live = real retrieval and model calls
APP_MODE=demo

# Model provider: portkey (course key, gpt-6-luna only) | openai (personal key) | none
LLM_PROVIDER=portkey
PORTKEY_API_KEY=
# PORTKEY_MODEL is fixed to gpt-6-luna; any other value is rejected.
PORTKEY_MODEL=gpt-6-luna

# Optional personal OpenAI provider (used only when LLM_PROVIDER=openai; model must be set explicitly)
OPENAI_API_KEY=
OPENAI_MODEL=

# Optional: SEC fair-access policy requires a contact in the User-Agent to read filing documents
# Example: SEC_USER_AGENT=Your Company Name contact@yourcompany.example
SEC_USER_AGENT=

# Optional overrides (defaults shown)
# DATABASE_PATH=data/ocra_live.db        (demo mode default: data/demo.db)
# RESEARCH_CACHE_PATH=data/public_research_cache.db
# APP_TIMEZONE=Asia/Hong_Kong
# BRIEFING_HOUR=7
# ENABLE_SCHEDULER=true
# RESEARCH_CACHE_TTL_HOURS=20
# DAILY_RUN_LIMIT=300
# DAILY_TOKEN_LIMIT=1500000
# DAILY_COST_LIMIT_USD=5
# AGENT_RUN_REQUEST_LIMIT=8
# AGENT_RUN_TOOL_CALLS_LIMIT=12
# AGENT_RUN_TOTAL_TOKENS_LIMIT=60000
# AGENT_RUN_TIMEOUT_SECONDS=120
# UPLOAD_MAX_BYTES=5242880
# IMPORT_MAX_ROWS=5000
